@@ -1,6 +1,43 @@
 import json
 
+VALID_LEVELS = ("debug", "info", "warning", "error")
 
-def summarize(lines):
-    rows = [json.loads(line) for line in lines]
-    return {"total": len(rows), "invalid": 0, "levels": {}}
+
+def summarize(lines, min_level=None):
+    if min_level is None:
+        threshold = 0
+    else:
+        if not isinstance(min_level, str):
+            raise ValueError("min_level must be a string or None")
+        normalized = min_level.strip().lower()
+        if normalized not in VALID_LEVELS:
+            raise ValueError("invalid min_level: {!r}".format(min_level))
+        threshold = VALID_LEVELS.index(normalized)
+
+    total = 0
+    invalid = 0
+    levels = {}
+    for line in lines:
+        if not line.strip():
+            continue
+        try:
+            obj = json.loads(line)
+        except ValueError:
+            invalid += 1
+            continue
+        if not isinstance(obj, dict):
+            invalid += 1
+            continue
+        level = obj.get("level", "info")
+        if not isinstance(level, str) or not level.strip():
+            invalid += 1
+            continue
+        level = level.strip().lower()
+        if level not in VALID_LEVELS:
+            invalid += 1
+            continue
+        if VALID_LEVELS.index(level) < threshold:
+            continue
+        total += 1
+        levels[level] = levels.get(level, 0) + 1
+    return {"total": total, "invalid": invalid, "levels": levels}
