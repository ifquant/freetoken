+def collect_paths(root, suffixes, include_hidden=False):
+    """Collect regular files below ``root`` as sorted, relative POSIX paths.
+
+    Hidden files/directories (any path segment starting with ``.``) are
+    excluded unless ``include_hidden`` is true.  All symbolic links are always
+    excluded and linked directories are never followed.  ``suffixes`` accepts
+    extensions with or without a leading dot and is matched case-sensitively.
+    An empty ``suffixes`` keeps every file.
+    """
+    root = os.fspath(root)
+    normalized = {suffix if suffix.startswith(".") else "." + suffix for suffix in suffixes}
+
+    results = []
+    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
+        dirnames[:] = [
+            name
+            for name in dirnames
+            if (include_hidden or not name.startswith("."))
+            and not os.path.islink(os.path.join(dirpath, name))
+        ]
+        for name in filenames:
+            if name.startswith(".") and not include_hidden:
+                continue
+            full = os.path.join(dirpath, name)
+            if os.path.islink(full) or not os.path.isfile(full):
+                continue
+            if normalized and not any(name.endswith(suffix) for suffix in normalized):
+                continue
+            results.append(os.path.relpath(full, root).replace(os.sep, "/"))
+
+    return sorted(results)
